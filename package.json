{
  "name": "paseo-artifact-viewer",
  "version": "0.9.3",
  "private": true,
  "description": "Preview and edit HTML and React artifacts from Paseo conversations and files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shotgun1107/paseo-artifact-viewer.git"
  },
  "homepage": "https://github.com/shotgun1107/paseo-artifact-viewer",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "artifacts",
    "html",
    "react"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "server/",
    "client/",
    "shared/",
    "README.md",
    "OVERVIEW.md",
    "OVERVIEW.ko.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "media/gallery.png",
    "media/preview.png",
    "media/icon.png"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "test:browser": "node --import tsx test/browser.mts",
    "verify:package": "node scripts/verify-package.mjs",
    "test:browser:package": "node --import tsx test/browser.mts --package"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-html": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@codesandbox/sandpack-client": "2.19.8",
    "saxes": "6.0.0",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@getpaseo/client": "0.17.4",
    "@getpaseo/plugin": "0.17.4",
    "@getpaseo/protocol": "0.17.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.56.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "type": "module"
}
