{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "react",
      "node"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "index.client.tsx",
    "index.server.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/browser*.tsx",
    "test/browser*.mts",
    "test/browser*.mjs"
  ]
}
