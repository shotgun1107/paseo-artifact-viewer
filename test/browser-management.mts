import assert from "node:assert/strict";
import { readFile, writeFile } from "node:fs/promises";
import { join } from "node:path";
import type { Page } from "playwright-core";
import type { startServerFixture } from "./browser-server.mjs";

export async function testManagement(page: Page, server: Awaited<ReturnType<typeof startServerFixture>>, calls: { name: string; input: any }[], output: string, mode: string) {
  const sessionId = "management";
  const button = (name: string) => page.getByRole("button", { name, exact: true });
  const toolbar = page.getByRole("toolbar", { name: "아티팩트 도구" });
  const workbench = page.locator('section[aria-label="아티팩트 작업 공간"]');
  const html = page.frameLocator('iframe[title="아티팩트 실행 화면"]').frameLocator('iframe[title="아티팩트 문서"]');
  const main = page.getByTestId("explorer-content");
  const measurements: { viewport: number; toolbar: number; menu: number; panel: number; x: number; y: number }[] = [];
  const original = "테스트 결과";
  const renamed = "길이가 긴 아티팩트 제목으로 좁은 패널의 헤더 한 줄 배치를 확인하는 검증 결과";
  let title = original;
  const openMenu = () => button(title + " 메뉴").click();
  async function action(command: string) {
    await openMenu();
    await page.locator('[role=menuitem][data-command="' + command + '"]').click();
  }
  await button(original + " 아티팩트 열기").first().click();
  await page.locator('section[data-artifact-version="1"]').waitFor();
  const artifactId = await workbench.getAttribute("data-artifact-id");
  assert.ok(artifactId);
  const target = { sessionId, artifactId };
  const get = () => server.rpc("artifact.get", target);
  const sourceV1 = (await get()).version.content;
  await page.evaluate(() => (window as any).fixture.append("html", '<div id="v2">두 번째 버전</div>'));
  await html.locator("#v2").waitFor();
  await button("아티팩트 버전").click();
  await page.getByRole("menuitemradio", { name: "버전 1", exact: true }).click();
  await html.locator("#counter").waitFor();

  await action("rename");
  const input = page.getByRole("textbox", { name: "아티팩트 이름" });
  await input.fill(renamed);
  await input.press("Enter");
  title = renamed;
  await button(title + " 메뉴").waitFor();
  assert.equal((await get()).artifact.title, title);
  for (const width of [1400, 400, 320]) {
    await page.setViewportSize({ width, height: 840 });
    assert.equal(await page.locator("[data-inline-viewer]").count(), 0);
    const panel = await workbench.boundingBox(); assert.ok(panel);
    const area = await main.boundingBox(); assert.ok(area);
    assert.ok(Math.abs(panel.x - area.x) <= 1 && Math.abs(panel.y - area.y) <= 1 && Math.abs(panel.height - area.height) <= 1);
    assert.ok(Math.abs(panel.x + panel.width - width) <= 1, JSON.stringify({ width, panel, area }));
    const chat = await page.getByTestId("timeline").boundingBox();
    assert.ok(chat && chat.width > 0 && chat.x + chat.width <= panel.x + 1);
    const labels = [title + " 메뉴", "아티팩트 버전", "코드 복사", "아티팩트 탭 닫기"];
    const rects = [];
    for (const label of labels) {
      const control = toolbar.getByRole("button", { name: label, exact: true });
      await control.click({ trial: true });
      const rect = await control.boundingBox(); assert.ok(rect); rects.push(rect);
    }
    const bounds = await toolbar.boundingBox(); assert.ok(bounds);
    for (let i = 0; i < rects.length; i++) {
      const rect = rects[i];
      assert.ok(rect.x >= bounds.x - 1 && rect.x + rect.width <= bounds.x + bounds.width + 1, "control clipped at " + width);
      assert.ok(Math.abs((rect.y + rect.height / 2) - (rects[0].y + rects[0].height / 2)) < 2, "control wrapped at " + width);
      if (i > 0) assert.ok(rect.x >= rects[i-1].x + rects[i-1].width - 1, "overlapping controls");
    }
    assert.equal(await page.evaluate(() => document.fullscreenElement !== null), false);
    await openMenu();
    const items = page.getByRole("menuitem");
    assert.deepEqual(await items.allInnerTexts(), ["내보내기", "웹에서 열기", "고정", "이름 변경", "복제", "새로고침", "삭제"]);
    const menu = await page.getByRole("menu", { name: "현재 아티팩트 메뉴" }).boundingBox(); assert.ok(menu);
    assert.ok(menu.x >= bounds.x - 1 && menu.x + menu.width <= bounds.x + bounds.width + 1);
    measurements.push({ viewport: width, toolbar: bounds.width, menu: menu.width, panel: panel.width, x: panel.x, y: panel.y });
    await page.screenshot({ path: join(output, mode + "-menu-" + width + ".png") });
    await page.keyboard.press("Escape");
  }
  await writeFile(join(output, mode + "-header-measurements.json"), JSON.stringify(measurements, null, 2) + "\n");
  await page.setViewportSize({ width: 1400, height: 840 });
  await button("코드 복사").click();
  assert.equal(await page.evaluate(() => (window as any).fixture.state.copied), sourceV1);
  const download = page.waitForEvent("download");
  await action("export");
  const file = await download;
  assert.ok(file.suggestedFilename().endsWith(".html"));
  assert.equal(await readFile((await file.path())!, "utf8"), sourceV1);
  await html.locator("#counter").click();
  assert.equal(await html.locator("#counter").innerText(), "1");
  assert.equal(await page.evaluate(() => document.fullscreenElement !== null), false);
  await action("refresh");
  await html.locator("#counter").filter({ hasText: /^0$/ }).waitFor();
  await action("web");
  const link = page.getByRole("link", { name: "웹에서 열기 링크" });
  const popupEvent = page.context().waitForEvent("page");
  await link.click();
  const popup = await popupEvent;
  await popup.frameLocator("iframe").locator("#counter").click();
  assert.equal(await popup.frameLocator("iframe").locator("#counter").innerText(), "1");
  assert.equal(new URL(popup.url()).hostname, "127.0.0.1");
  await popup.close();
  await button("웹 링크 닫기").click();
  await action("pin");
  await page.getByLabel("고정됨", { exact: true }).waitFor();
  assert.ok((await get()).artifact.pinned);
  await action("duplicate");
  title = renamed + " 사본";
  await button(title + " 메뉴").waitFor();
  const copyId = await workbench.getAttribute("data-artifact-id");
  assert.ok(copyId && copyId !== artifactId);
  const copyTarget = { sessionId, artifactId: copyId };
  assert.equal((await server.rpc("artifact.get", copyTarget)).version.content, sourceV1);
  await action("delete");
  const confirm = page.getByRole("dialog", { name: "아티팩트 삭제" });
  await confirm.getByRole("button", { name: "취소" }).click();
  assert.ok(await server.rpc("artifact.get", copyTarget));
  await action("delete");
  await confirm.getByRole("button", { name: "삭제" }).click();
  await page.locator('[data-bar="undo"][data-phase="deleted"]').waitFor();
  assert.equal(await server.rpc("artifact.get", copyTarget), null);
  await button("삭제 되돌리기").click();
  await button(title + " 메뉴").waitFor();
  assert.equal((await server.rpc("artifact.get", copyTarget)).version.content, sourceV1);
  await page.setViewportSize({ width: 1400, height: 840 });
  await button("아티팩트 탭 닫기").click();
  await button(original + " 아티팩트 열기").first().waitFor();
  await page.reload();
  await button(original + " 아티팩트 열기").first().click();
  await button(renamed + " 메뉴").waitFor();
  await page.getByLabel("고정됨", { exact: true }).waitFor();
  assert.equal((await server.rpc("artifact.list", { sessionId })).items.length, 2);
  await button(renamed + " 메뉴").click();
  await page.locator('[data-command="delete"]').click();
  await confirm.getByRole("button", { name: "삭제" }).click();
  await page.locator('[data-bar="undo"][data-phase="deleted"]').waitFor();
  assert.equal(await get(), null);
  let rejected = false;
  await page.route("**/rpc", async route => {
    const input = route.request().postDataJSON();
    if (!rejected && input.name === "artifact.manage" && input.input.action.type === "restore") {
      rejected = true;
      await route.fulfill({ status: 503, json: { error: "QA 일시적인 연결 오류" } });
    } else await route.continue();
  });
  await button("삭제 되돌리기").click();
  await page.getByText(/QA 일시적인 연결 오류/).waitFor();
  assert.ok(rejected);
  await button("삭제 되돌리기").click();
  await button(renamed + " 메뉴").waitFor();
  assert.equal((await get()).artifact.title, renamed);
  const actions = calls.filter(c => c.name === "artifact.manage" && c.input.sessionId === sessionId).map(c => c.input.action.type);
  for (const kind of ["rename", "web", "pin", "duplicate", "delete", "restore"]) assert.ok(actions.includes(kind), kind);
  assert.equal(calls.some(c => c.name === "artifact.feedback" || c.input?.action?.type === "feedback"), false);
}
